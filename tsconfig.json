{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "api/**/*.js",
    "server/**/*.cjs",
    "src/**/*.js",
    "src/**/*.d.ts",
    "scripts/**/*.cjs",
    "tests/catalog.test.cjs",
    "tests/auth.test.cjs",
    "tests/entitlement.test.cjs",
    "tests/all-guides-protection.test.cjs"
  ]
}
