{
  "name": "bluegee-library-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static audio guide catalogue generated from one product master.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint src api server scripts tests eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "type-check": "npm run typecheck",
    "validate": "node scripts/validate-catalog.cjs",
    "build": "node scripts/build-catalog.cjs",
    "build:check": "node scripts/build-catalog.cjs --check",
    "test": "node --test tests/catalog.test.cjs",
    "test:browser": "node tests/e2e/catalog-browser.cjs",
    "dev": "node scripts/serve.cjs",
    "test:auth": "node --test tests/auth.test.cjs",
    "test:auth:browser": "node tests/e2e/auth-browser.cjs",
    "test:entitlement": "node --test tests/entitlement.test.cjs",
    "test:entitlement:browser": "node tests/e2e/entitlement-browser.cjs",
    "test:protection": "node --test tests/all-guides-protection.test.cjs",
    "test:protection:browser": "node tests/e2e/all-guides-protection.cjs"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  }
}
